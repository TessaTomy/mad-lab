<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="5dp"
        app:columnCount="4"
        app:rowCount="5"
        tools:layout_editor_absoluteX="-16dp"
        tools:layout_editor_absoluteY="50dp">

        <!-- Display -->
        <TextView
            android:id="@+id/textView6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:background="#F2E9E9"
            android:gravity="right|center_vertical"
            android:text="0"
            android:textColor="#942553"
            android:textSize="48sp"
            android:textStyle="bold"
            app:layout_column="0"
            app:layout_columnSpan="4"
            app:layout_columnWeight="1"
            app:layout_row="0"
            app:layout_rowWeight="1" />

        <!-- 1 2 3 + -->
        <Button
            android:id="@+id/n1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_row="1"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/n2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_row="1"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/n3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_row="1"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/add"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_row="1"
            app:layout_rowWeight="1" />

        <!-- 4 5 6 - -->
        <Button
            android:id="@+id/n4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="4"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_row="2"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/n5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_row="2"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/n6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="6"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_row="2"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/sub"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_row="2"
            app:layout_rowWeight="1" />

        <!-- 7 8 9 / -->
        <Button
            android:id="@+id/n7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="7"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_row="3"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/n8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="8"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_row="3"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/n9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="9"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_row="3"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/div"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="/"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_row="3"
            app:layout_rowWeight="1" />

        <!-- 0 C = x -->
        <Button
            android:id="@+id/n0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="0"
            app:layout_columnWeight="1"
            app:layout_row="4"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/clr"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="C"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="1"
            app:layout_columnWeight="1"
            app:layout_row="4"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/eq"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="="
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="2"
            app:layout_columnWeight="1"
            app:layout_row="4"
            app:layout_rowWeight="1" />

        <Button
            android:id="@+id/mul"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:backgroundTint="#992555"
            android:text="x"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_column="3"
            app:layout_columnWeight="1"
            app:layout_row="4"
            app:layout_rowWeight="1" />

    </androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
